{
  "App": {
    "Role": "All",
    "Version": "dev",
    "MinVersion": {}
  },
  "AWS": {
    "Region": "ap-southeast-1"
  },
  "Admin": {
    "BootstrapEmails": [],
    "AllowedEmailDomains": []
  },
  "CustomerAuth": {
    "Issuer": "extraspace",
    "Audience": "extraspace-app"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "Host": "",
    "Name": "extraspace",
    "MaxPoolSize": 50,
    "RequireMigrated": true
  },
  "DataProtection": {
    "SsmPath": ""
  },
  "Email": {
    "Transport": "Ses",
    "From": "",
    "AllowedRecipients": []
  },
  "Jobs": {
    "WorkerCount": 5,
    "QueuePollInterval": "00:00:05"
  },
  "Logging": {
    "SlowQueryMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Hangfire": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "SiteLink": {
    "BaseUrl": "https://api.smdservers.net/CCWs_3.5/CallCenterWs.asmx",
    "WriteAllowList": [ "LSETUP" ],
    "AllowWritesToAllSites": false,
    "CallsPerSecond": 2,
    "MonthlyCallAlarm": 0
  },
  "AllowedHosts": "*"
}
