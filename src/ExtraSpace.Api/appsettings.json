{
  "App": {
    "Role": "All",
    "Version": "dev",
    "MinVersion": {}
  },
  "AWS": {
    "Region": "ap-southeast-1"
  },
  "Admin": {
    "BootstrapEmails": [],
    "Entra": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "CustomerAuth": {
    "Issuer": "extraspace",
    "Audience": "extraspace-app"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DataProtection": {
    "SsmPath": ""
  },
  "Email": {
    "Transport": "Ses",
    "From": ""
  },
  "Jobs": {
    "WorkerCount": 5,
    "QueuePollInterval": "00:00:05"
  },
  "Logging": {
    "SlowQueryMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Hangfire": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
